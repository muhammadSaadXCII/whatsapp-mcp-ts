# Originally generated by https://smithery.ai (see https://smithery.ai/docs/config#dockerfile),
# then updated for the current code: run with Node's built-in TypeScript support,
# glibc base image for ffmpeg-static, non-root user, and volumes for login and data.

# Debian-based on purpose: the ffmpeg binary that `ffmpeg-static` downloads needs glibc
# and does not run on Alpine. Voice notes depend on it.
FROM node:23-slim

WORKDIR /app

# Install dependencies from the lockfile (reproducible). The build tools are only
# needed while installing, so they are removed again in the same layer.
COPY package.json package-lock.json ./
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git python3 make g++ \
    && npm ci \
    # Fail the build now if the bundled ffmpeg cannot run, instead of failing on the first voice note.
    && node -e "require('child_process').execFileSync(require('ffmpeg-static'), ['-version'], { stdio: 'ignore' })" \
    && apt-get purge -y --auto-remove git python3 make g++ \
    && rm -rf /var/lib/apt/lists/* /root/.npm

# Source (tsconfig.json is kept for editors and type checks; it is not needed to run)
COPY tsconfig.json ./
COPY src ./src

# Folders the server writes to. Create them and give them to the non-root user.
RUN mkdir -p auth_info data info downloads outbox \
    && chown -R node:node /app
USER node

# Keep these outside the container, or you must scan the WhatsApp QR code again on every run
# and lose your message history:
#   auth_info = your WhatsApp login (sensitive), data = messages and contacts (sensitive)
#   outbox    = files you want the agent to be able to send
#   downloads = media saved by download_media
VOLUME ["/app/auth_info", "/app/data", "/app/outbox", "/app/downloads"]

# No ports: the MCP server talks over stdio, so run the container with `docker run -i` (no -t).
# Node 23.6+ runs .ts files directly; ts-node is not needed.
CMD ["node", "src/main.ts"]